---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

// カテゴリ一覧（/news/category/:slug へのリンク）。
// 現行サイトにもカテゴリページがあり、検索流入を持っている可能性が高いので
// 一覧からの内部リンクを必ず張る。
const categories = [
  ...new Map(posts.map((post) => [post.data.category, post.data.categoryName])).entries(),
];

const dateFormat = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="お知らせ"
  description="TODO: 現行 /news ページのmeta descriptionを移植してください。"
>
  <h1>お知らせ</h1>

  {
    categories.length > 0 && (
      <nav aria-label="カテゴリ">
        <ul>
          {categories.map(([slug, name]) => (
            <li>
              <a href={`/news/category/${slug}`}>{name}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <ul>
    {
      posts.map((post) => (
        <li>
          <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
            {dateFormat.format(post.data.publishedAt)}
          </time>
          <a href={`/news/${post.id}`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
